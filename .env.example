# Copy to .env and adjust as needed.

# Postgres connection string. The value below matches docker-compose.dev.yml
# (run `npm run db:up` to start that container). Railway injects its own
# DATABASE_URL in production — nothing here is read there.
DATABASE_URL=postgres://mocoweb:mocoweb@localhost:5433/mocoweb

# S3-compatible object storage for media (src/lib/server/cms/media/). Local
# dev talks to the SeaweedFS container in docker-compose.dev.yml (also
# started by `npm run db:up`); the credentials below match
# docker/seaweedfs-s3-config.json. In production, Railway Buckets injects
# these five variables itself — nothing here is read there, and the client
# code has no provider-specific logic, only these env vars.
BUCKET=mocoweb-media
ENDPOINT=http://localhost:9000
ACCESS_KEY_ID=devaccesskeyid
SECRET_ACCESS_KEY=devsecretaccesskey
REGION=us-east-1
